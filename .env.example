# Telegram bot API token (from @BotFather)
TOKEN=123456:your-telegram-bot-token

# Comma-separated list of chat IDs the bot is allowed to respond to.
# Any message from a chat ID not in this list is ignored.
CHAT_IDS=123456789,987654321

# Path to the JSON file where searches, filters and seen listings are persisted.
# For Docker Compose use a path inside the mounted volume: /data/state.json
# For a local run, a relative path like data/state.json works fine.
STATE_FILE=/data/state.json
